{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": [
    "eslint:recommended"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": {
      "jsx": true
    }
  },
  "plugins": [],
  "rules": {
    "no-unused-vars": "off",
    "no-undef": "off",
    "no-redeclare": "off"
  },
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "*.config.js",
    "*.config.ts"
  ]
}
